// require MT >= 2.16.0
// Syntax: JsonUI
// Version: v1.6
// License: CC BY-NC 4.0
// Repo: https://github.com/wisebreeze/MT-syntax

// Author: QiE
{
  name:["JsonUI", ".json", ".jsonui", ".json_ui", ".material"]
  styles:[
    "default", #333,    #DADADA
    "comment", #777#FDD,#999#522
    "error",   #F00#000,#F00#000, @BS
    "str",     #047,    #79B
    "subStr",  #066,    #6CB
    "keyword", #A50,    #E82
    "var",     #970,    #ED8
    "expr",    #809,    #BAE
    "operator",#071,    #AD8
    "number",  #06E,    #5DD
  ]
  comment:{startsWith:"//"}
  comment:{startsWith:"/*",endsWith:"*/"}
  bracketPairs:["{}","[]","()"]
  codeFormatter:#BUILT_IN_JSON_FORMATTER#
  codeShrinker:#BUILT_IN_JSON_SHRINKER#
  defines:[
    "AtSign":{match:/@/}
    "Int":/-?(?:0|[1-9][0-9]*)/ // 整数
    "Number":include("Int")+/(?:\.[0-9]+)?/ // 数字
    "Operator":/[-+*\/=<>]/ // 普通运算符
    "ExprEnd":{match:/(?m)(?=(?:[\s()"]|/+include("Operator")+/|$))/} // 表达式内硬编码或变量结束
    "StrEnd":{match:/(?m)(?="|$)/} // 字符串结束
    "Escape":[ // 转义
      {match:/(?:\\(?:[btnfr"'\\\/]|u[a-fA-F0-9]{4}))+/,0:"keyword"}
      {match:/(?:\\.)+/,0:"error"}
    ]
    "Reference":{ // 引用
      style:"expr"
      start:{match:/@/,0:"keyword"}
      end:{include:"StrEnd"}
      contains:[
        {include:"AtSign"}=>FAIL
        {
          style:"var" // @$xxx
          start:{match:/(?<=@)\$/}
          end:{include:"StrEnd"}
          contains:[{include:"AtSign"}=>FAIL]
        }
        {
          style:"keyword" // @x.y 中的 .y
          start:{match:/\./,0:"subStr"}
          end:{include:"StrEnd"}
          contains:[{include:"AtSign"}=>FAIL]
        }
      ]
    }
  ]
  contains:[
    {
      style:"str" // "xxx"
      start:{match:/"/}
      end:{match:/(?m)"|$/}
      mustMatchEnd:true
      contains:[
        {include:"Escape"}
        {include:"Reference"}
        {match:/(?<="!)(#[A-Fa-f0-9]{3,8})(?=!")/,1:"parseColor(auto,0,HEX)"} // !#hex! 预览颜色
        {
          style:"number" // 百分比、像素运算
          start:{match:/(?<=")(?=/+include("Number")+/(?:px|%))/}
          end:{include:"StrEnd"}
          contains:[{match:/[+-]/,0:"operator"}] // + -
        }
        {
          start:{match:/(?<=")(?=\()/} // 表达式
          end:{include:"StrEnd"}
          contains:[
            {match:keywordsToRegex("not or and")+/|/+include("Operator"),0:"operator"} // 逻辑运算符及普通运算符
            {match:include("Int")+/(?:\.0+)?/+/\b/,0:"number"} // 数字
            {match:/[()]/,0:"expr"} // 括号
            {
              style:"subStr" // 'xxx'
              start:{match:/'/}
              end:{match:/(?m)'|$/}
              mustMatchEnd:true
              contains:[{include:"Escape"}]
            }
            {
              style:"keyword" // #xxx
              start:{match:/#/}
              end:{include:"ExprEnd"}
            }
            {
              style:"var" // $xxx
              start:{match:/\$/}
              end:{include:"ExprEnd"}
            }
          ]
        }
        {
          style:"expr" // #xxx
          start:{match:/(?<=")#/}
          end:{include:"StrEnd"}
        }
        {
          style:"var" // $xxx
          start:{match:/(?<=")\$/}
          end:{include:"StrEnd"}
          contains:[
            {match:/\|(?!default")/}=>FAIL // |后非default
            {match:/(\|)default(?=")/,0:"keyword",1:"subStr"} // |default
            {include:"Reference"}
          ]
        }
      ]
    }
    {match:include("Number")+/(?:[eE][+-]?[0-9]+)?\b/,0:"number"} // 数字（支持科学记数法）
    {match:keywordsToRegex("false true null"),0:"operator"} // 布尔值
  ]
}
